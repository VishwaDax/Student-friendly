# Copy to .env and set local values. Never commit real credentials.

# Optional NVIDIA-hosted answer generation.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_MAX_RETRIES=2

# RRF score threshold (provisional; calibrate against representative books).
TEXTBOOK_MIN_EVIDENCE_SCORE=0.015

# Local development: verification codes are printed in the Django terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=StudyMate AI <noreply@example.com>

# For real email delivery, set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and fill in EMAIL_HOST,
# EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, and a provider-approved sender above.

# Optional OCR trained-data directory (defaults to media/tessdata).
# TESSERACT_DATA_DIR=media/tessdata
