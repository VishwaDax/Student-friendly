# Copy to .env and set values locally. Never commit real credentials.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_MAX_RETRIES=2

# RRF score threshold is provisional; calibrate against representative books.
TEXTBOOK_MIN_EVIDENCE_SCORE=0.015
